# Treasure Coast Outlaws — folder settings.

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Enabling the engine here also stops any parent-folder rewrite rules
    # (e.g. bot24.io's root .htaccess) from being applied to this directory.

    # 1) Hide the .php extension: if someone requests /admin.php, send them a
    #    301 to the clean /admin. Uses the full original request path, so it
    #    works no matter which subfolder the site lives in.
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php([?\s]|$) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2) Internally serve the .php file for a clean URL (e.g. /admin -> admin.php)
    #    without changing what the visitor sees in the address bar.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Serve the home page for the folder root.
DirectoryIndex index.php
